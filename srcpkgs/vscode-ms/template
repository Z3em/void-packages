# Template file for 'vscode-ms'
pkgname=vscode-ms
version=1.143.1
revision=1
archs="x86_64"
create_wrksrc=yes
depends="xdg-utils"
short_desc="Microsoft Visual Studio Code"
maintainer="Z3em <anem@protonmail.com>"
license="custom:Proprietary"
homepage="https://code.visualstudio.com/"
distfiles="https://update.code.visualstudio.com/${version}/linux-x64/stable>vscode-ms-${version}.tar.gz"
checksum=48f658052e54e020a1c1be7b37ac0f9ae39f07e8ccda805c63f053cfda72b2be
repository=nonfree
restricted=yes
nostrip=yes
noshlibprovides=yes

post_extract() {
	mv VSCode-linux-x64/* .
	rmdir VSCode-linux-x64
}

do_install() {
	vmkdir usr/lib/vscode-ms
	vcopy . usr/lib/vscode-ms

	vmkdir usr/bin
	ln -s ../lib/vscode-ms/bin/code ${DESTDIR}/usr/bin/code

	vinstall ${FILESDIR}/vscode-ms.desktop 644 usr/share/applications
	vinstall resources/app/resources/linux/code.png 644 usr/share/pixmaps vscode-ms.png
	vlicense LICENSES.chromium.html
}
