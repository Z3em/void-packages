# Template file for 'uzdoom'
pkgname=uzdoom
version=5.0.1
revision=1
archs="x86_64* aarch64*"
build_style=cmake
configure_args="
 -DINSTALL_PK3_PATH=share/games/uzdoom
 -DINSTALL_SOUNDFONT_PATH=share/games/uzdoom
 -DCMAKE_SKIP_RPATH=ON
 -DDYN_OPENAL=OFF
 -DDYN_SNDFILE=OFF
 -DDYN_MPG123=OFF
 -DFORCE_NO_LTO=ON"
hostmakedepends="pkg-config python3"
makedepends="
 SDL2-devel
 alsa-lib-devel
 bzip2-devel
 dbus-devel
 libglib-devel
 libgomp-devel
 libopenal-devel
 libsndfile-devel
 libvpx-devel
 mpg123-devel"
short_desc="Modern feature-centric Doom source port"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="https://github.com/UZDoom/UZDoom"
distfiles="https://github.com/UZDoom/UZDoom/archive/refs/tags/${version}.tar.gz"
checksum=8135b15d151d18fd20f85839d9bf48beefc4e074b406ffba30d7c46f8479b430
nocross=yes

if [ "$XBPS_TARGET_LIBC" = musl ]; then
	CFLAGS+=" -DZ7_AFFINITY_DISABLE"
	CXXFLAGS+=" -DZ7_AFFINITY_DISABLE"
	makedepends+=" musl-fts-devel libexecinfo-devel"
fi

# Supply release version information because GitHub tag archives contain no
# .git directory for UZDoom's revision-generation script.
export GIT_DESCRIBE="${version}"

post_install() {
	# Bundled libraries are linked statically; do not ship their development files.
	rm -rf "${DESTDIR}/usr/include" "${DESTDIR}/usr/lib/cmake"
	rm -f "${DESTDIR}/usr/lib/libcppdap.a" "${DESTDIR}/usr/lib/libzmusic.a"
}
