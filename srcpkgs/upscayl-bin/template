do_install() {
	local dest="usr/lib/upscayl" item size
	local notices="${XBPS_SRCDISTDIR}/${pkgname}-${version}"

	vmkdir "$dest"
	for item in upscayl chrome_crashpad_handler *.so* *.pak *.bin *.dat *.json locales resources; do
		vcopy "$item" "$dest"
	done
	rm "${DESTDIR}/${dest}/resources/app-update.yml"
	# Rely on Chromium's namespace sandbox where available, not a setuid helper.
	chmod 0755 "${DESTDIR}/${dest}/upscayl" "${DESTDIR}/${dest}/chrome_crashpad_handler" \
		"${DESTDIR}/${dest}/resources/bin/upscayl-bin"
	patchelf --remove-rpath "${DESTDIR}/${dest}/resources/bin/upscayl-bin"

	vbin "${FILESDIR}/upscayl"
	vinstall "${FILESDIR}/org.upscayl.Upscayl.desktop" 644 usr/share/applications
	for size in 128 512; do
		vinstall "resources/${size}x${size}.png" 644 \
			"usr/share/icons/hicolor/${size}x${size}/apps" org.upscayl.Upscayl.png
	done

	vlicense LICENSE.electron.txt
	vlicense LICENSES.chromium.html
	for item in ${skip_extraction}; do
		vlicense "${notices}/${item}"
	done
	vdoc "${FILESDIR}/README.void"
}
